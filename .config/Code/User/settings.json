{
  // Workbench
  "workbench.iconTheme": "vscode-icons",
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Atom One Dark",
  "workbench.preferredDarkColorTheme": "Atom One Dark",
  "workbench.preferredLightColorTheme": "Atom One Light",
  // Editor
  "editor.fontFamily": "Fira Code, monospace",
  "editor.fontSize": 16,
  "editor.fontWeight": "600",
  "editor.fontLigatures": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.linkedEditing": true,
  // Disable telemetry
  "telemetry.telemetryLevel": "off",
  // Discord
  "discord.detailsEditing": "Line {current_line} of {total_lines}. None of your business",
  "discord.detailsDebugging": "I am not debugging. No bugs",
  "discord.detailsIdling": "Not idling. Working very hard.",
  "discord.largeImage": "Editing a {LANG} file. But i don't know {lang}",
  "discord.largeImageIdling": "Not idling. Working very hard.",
  "discord.lowerDetailsDebugging": "I am not debugging. No bugs",
  "discord.lowerDetailsEditing": "Get Out",
  "discord.lowerDetailsIdling": "Not idling. Working very hard.",
  "discord.lowerDetailsNoWorkspaceFound": "Get Out",
  "discord.smallImage": "1.0.0-archnobugs-release-69",
  "discord.removeRemoteRepository": true,
  // Git
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.confirmSync": false,

  // Format assosiations
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },

  // Explorer and files
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.autoSave": "afterDelay",

  // Ignore recommendations
  "extensions.ignoreRecommendations": true,

  // Terminal
  "terminal.integrated.scrollback": 10000,
  "security.workspace.trust.untrustedFiles": "open",
  "window.confirmSaveUntitledWorkspace": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.formatOnType": true,
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "github.copilot.editor.enableAutoCompletions": true,
  "prisma.showPrismaDataPlatformNotification": false,
  "diffEditor.renderSideBySide": true,
  "editor.formatOnSave": true,
  "[php]": {
    "editor.defaultFormatter": "DEVSENSE.phptools-vscode"
  },
  "diffEditor.ignoreTrimWhitespace": false
}
